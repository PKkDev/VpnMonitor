<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VpnMonitor.WUI.MVVM.View.ActualClientsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VpnMonitor.WUI.MVVM.View"
    xmlns:model="using:VpnMonitor.WUI.MVVM.Model"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid RowSpacing="10" Padding="5 5">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Fills up until the next automatic refresh; a click refreshes right away -->
            <Button
                Grid.Column="0"
                Padding="4"
                Command="{x:Bind ViewModel.OnRefreshData}"
                ToolTipService.ToolTip="Данные обновляются автоматически раз в минуту. Нажмите, чтобы обновить сейчас">
                <ProgressRing
                    Width="26" Height="26"
                    IsActive="True"
                    IsIndeterminate="{x:Bind ViewModel.Status.IsLoading, Mode=OneWay}"
                    Minimum="0" Maximum="100"
                    Value="{x:Bind ViewModel.Status.Progress, Mode=OneWay}"
                    Foreground="Green"
                    Background="{ThemeResource ControlStrokeColorDefaultBrush}"/>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Последние данные на:"/>
                    <TextBlock Text="{x:Bind ViewModel.Status.LastInsertedText, Mode=OneWay}"/>
                </StackPanel>
                <TextBlock
                    Foreground="OrangeRed"
                    TextWrapping="Wrap"
                    Text="{x:Bind ViewModel.Status.ServiceWarning, Mode=OneWay}"/>
            </StackPanel>
        </Grid>

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Status.Clients, Mode=OneWay}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnClientClick">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:VpnClientActualDataResult">
                    <Grid Margin="0 5" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock
                                Foreground="{Binding ViewTitleColor}"
                                FontWeight="Bold"
                                FontSize="18"
                                Text="{x:Bind ViewTitle}"/>

                            <TextBlock
                                FontWeight="Bold"
                                FontSize="16"
                                Text="{x:Bind ViewStatus}"/>
                            <TextBlock
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewLastConnected}"/>

                            <Grid Visibility="{x:Bind IsOnline}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="10" ToolTipService.ToolTip="Скачивание">
                                    <TextBlock FontSize="16" Text="{x:Bind DownloadSpeed}"/>
                                    <FontIcon FontSize="16" Glyph="&#xE74B;"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10" ToolTipService.ToolTip="Отдача">
                                    <TextBlock FontSize="16" Text="{x:Bind UploadSpeed}"/>
                                    <FontIcon FontSize="16" Glyph="&#xE74A;"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <FontIcon
                            Grid.Column="1"
                            FontSize="12"
                            Glyph="&#xE76C;"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

    </Grid>

</Page>
